# Build directories
/build/
/*build*/
CMakeCache.txt
CMakeFiles/
*/CMakeFiles/
*/CMakeCache.txt
CTestTestfile.cmake
DartConfiguration.tcl
Makefile
cmake_install.cmake
install_manifest.txt

