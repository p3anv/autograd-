*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Logs and databases
*.log
*.sql
*.sqlite

# OS generated files
.DS_Store
Thumbs.db

# Vim swap files
*.swp

# Valgrind output
valgrind.out
vgcore.*

# Google Test and Google Benchmark downloaded by FetchContent
_fetchcontent/
_Deps/

